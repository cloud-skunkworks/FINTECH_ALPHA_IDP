{
  "name": "idp-platform-cdk",
  "version": "1.0.0",
  "description": "FinTech IDP Platform — AWS CDK Infrastructure",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "lint": "eslint 'lib/**/*.ts' 'bin/**/*.ts' 'test/**/*.ts'"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "aws-cdk": "2.1143.0",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "source-map-support": "0.5.21",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@aws-cdk/lambda-layer-kubectl-v36": "2.0.1",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
